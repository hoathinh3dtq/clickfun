{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClickFun",
  "version": "0.1.0",
  "identifier": "com.clickfun.booth",
  "build": {
    "frontendDist": "../../ui-pack"
  },
  "app": {
    "windows": [
      {
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "width": 1920,
        "height": 1080,
        "title": "ClickFun"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
